# Build-time settings for NeoTube. Copy to .env.
# Your fork's URL: used by the About and Changelog screens.
EXPO_PUBLIC_NEOTUBE_REPO=https://github.com/YOUR_NAME/NeoTube

# iOS only: your Apple Developer team id, for `expo run:ios` and store builds.
# EXPO_APPLE_TEAM_ID=

# Sync is off. Only enable it with your own backend (see PRIVACY.md).
# EXPO_PUBLIC_NEOTUBE_SYNC=1
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_NEOTUBE_API_HOST=

# Browser extension only (extension/wxt.config.ts reads the VITE_ names).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
